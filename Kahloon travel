<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kahloon Travel - Bus Ticket Booking & Terminal System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        @media print {
            body * { visibility: hidden; }
            #printable-voucher-area, #printable-voucher-area *, #savable-ticket-card, #savable-ticket-card * { visibility: visible; }
            #printable-voucher-area, #savable-ticket-card { position: absolute; left: 0; top: 0; width: 100%; }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <header class="bg-indigo-700 text-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <span class="text-3xl">🚍</span>
                <div>
                    <h1 class="text-xl font-bold tracking-wide">Kahloon Travel</h1>
                    <p class="text-xs text-indigo-200">Terminal Booking & Management Portal</p>
                </div>
            </div>
            <div class="flex items-center space-x-2">
                <button onclick="switchMainPortal('passenger')" id="btn-portal-passenger" class="px-3 py-2 text-xs md:text-sm font-medium rounded-lg bg-indigo-800 text-white transition hover:bg-indigo-900">Passenger Portal</button>
                <button onclick="switchMainPortal('user-login')" id="btn-portal-user" class="px-3 py-2 text-xs md:text-sm font-medium rounded-lg bg-indigo-600 text-indigo-100 transition hover:bg-indigo-800">Terminal User Login</button>
                <button onclick="promptAdminLogin()" id="btn-portal-admin" class="px-3 py-2 text-xs md:text-sm font-medium rounded-lg bg-indigo-600 text-indigo-100 transition hover:bg-indigo-800">Admin Panel</button>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-7xl w-full mx-auto px-4 py-6">
        
        <div id="custom-modal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4">
            <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl text-center">
                <div id="modal-icon" class="text-4xl mb-3">✅</div>
                <h3 id="modal-title" class="text-lg font-bold text-slate-900 mb-2">Message</h3>
                <p id="modal-message" class="text-slate-600 text-sm mb-6"></p>
                <button onclick="closeModal()" class="w-full bg-indigo-600 text-white py-2.5 rounded-xl font-medium hover:bg-indigo-700 transition">OK</button>
            </div>
        </div>

        <!-- Admin PIN Modal -->
        <div id="admin-login-modal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4">
            <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-2xl text-center">
                <div class="text-4xl mb-3">🔒</div>
                <h3 class="text-lg font-bold text-slate-900 mb-2">Admin Authentication</h3>
                <p class="text-slate-600 text-xs mb-4">Enter admin security PIN (Default: 786).</p>
                <input type="password" id="admin-pin-input" placeholder="Enter PIN" class="w-full px-3 py-2 text-sm border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none mb-4 text-center tracking-widest">
                <div class="flex space-x-2">
                    <button onclick="closeAdminLoginModal()" class="w-1/2 bg-slate-200 text-slate-700 py-2 rounded-xl text-sm font-medium hover:bg-slate-300">Cancel</button>
                    <button onclick="verifyAdminPin()" class="w-1/2 bg-indigo-600 text-white py-2 rounded-xl text-sm font-medium hover:bg-indigo-700">Login</button>
                </div>
            </div>
        </div>

        <section id="portal-passenger-view" class="space-y-6">
            <div class="bg-gradient-to-r from-indigo-600 to-blue-600 rounded-2xl p-6 text-white shadow-lg">
                <h2 class="text-2xl font-bold mb-2">Welcome to Kahloon Travel</h2>
                <p class="text-indigo-100 text-sm">Book online tickets easily, view 49-seat layouts, and make payments securely via JazzCash (03016594346).</p>
            </div>
            <div>
                <h3 class="text-lg font-bold mb-4 text-slate-800 flex items-center gap-2"><span>🚍</span> Available Buses & Routes</h3>
                <div id="passenger-bus-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
            </div>
        </section>

        <section id="portal-user-login-view" class="hidden max-w-md mx-auto bg-white rounded-2xl p-8 shadow-sm border border-slate-200 my-10">
            <div class="text-center mb-6">
                <span class="text-4xl">🏢</span>
                <h2 class="text-xl font-bold text-slate-900 mt-2">Terminal User Login</h2>
                <p class="text-xs text-slate-500">Sign in with credentials provided by Kahloon Travel Admin.</p>
            </div>
            <form onsubmit="handleUserLogin(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">Username</label>
                    <input type="text" id="login-username" required placeholder="Enter username" class="w-full px-3 py-2 text-sm border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">Password</label>
                    <input type="password" id="login-password" required placeholder="Enter password" class="w-full px-3 py-2 text-sm border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>
                <button type="submit" class="w-full bg-indigo-600 text-white py-2.5 rounded-xl text-sm font-medium hover:bg-indigo-700 transition shadow">Login to Terminal</button>
            </form>
        </section>

        <section id="portal-user-dashboard-view" class="hidden space-y-6">
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
