                </div>
                <button onclick="logoutTerminalUser()" class="bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs font-medium px-4 py-2 rounded-lg transition">Logout Terminal</button>
            </div>

            <!-- Terminal Dashboard Navigation Tabs -->
            <div class="flex flex-wrap gap-2 border-b pb-3">
                <button onclick="switchTerminalTab('booking')" id="term-tab-btn-booking" class="px-4 py-2 text-xs font-semibold rounded-lg bg-indigo-600 text-white">1. Ticket Booking</button>
                <button onclick="switchTerminalTab('voucher')" id="term-tab-btn-voucher" class="px-4 py-2 text-xs font-semibold rounded-lg bg-slate-200 text-slate-700 hover:bg-slate-300">2. Close Voucher</button>
                <button onclick="switchTerminalTab('records')" id="term-tab-btn-records" class="px-4 py-2 text-xs font-semibold rounded-lg bg-slate-200 text-slate-700 hover:bg-slate-300">3. Previous Records & Refund/Cancel</button>
            </div>

            <!-- Terminal Tab 1: Ticket Booking & Route Search Form -->
            <div id="term-tab-booking" class="space-y-6">
                <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
                    <h3 class="text-base font-bold text-slate-900 mb-4 flex items-center gap-2"><span>🔍</span> Search Bus Route & Timing</h3>
                    <form onsubmit="handleTerminalRouteSearch(event)" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">From (Route Boarding)</label>
                            <input type="text" id="search-from" required placeholder="e.g. Lahore" class="w-full px-3 py-2 text-sm border rounded-lg outline-none focus:ring-2 focus:ring-indigo-500">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">To (Destination)</label>
                            <input type="text" id="search-to" required placeholder="e.g. Multan" class="w-full px-3 py-2 text-sm border rounded-lg outline-none focus:ring-2 focus:ring-indigo-500">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">Date</label>
                            <input type="date" id="search-date" required class="w-full px-3 py-2 text-sm border rounded-lg outline-none focus:ring-2 focus:ring-indigo-500">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">Time</label>
                            <input type="text" id="search-time" required placeholder="e.g. 08:00 AM" class="w-full px-3 py-2 text-sm border rounded-lg outline-none focus:ring-2 focus:ring-indigo-500">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">Bus Name</label>
                            <input type="text" id="search-bus-name" required placeholder="e.g. Kahloon Express" class="w-full px-3 py-2 text-sm border rounded-lg outline-none focus:ring-2 focus:ring-indigo-500">
                        </div>
                        <div class="sm:col-span-2 lg:col-span-5 flex justify-end">
                            <button type="submit" class="bg-indigo-600 text-white px-6 py-2.5 rounded-lg text-sm font-medium hover:bg-indigo-700 transition shadow">Search & Open Seat Chart</button>
                        </div>
                    </form>
                </div>

                <!-- Bus 49 Seats Chart Container for Terminal Operator -->
                <div id="terminal-bus-seat-section" class="hidden bg-white rounded-2xl p-6 shadow-sm border border-slate-100 space-y-4">
                    <div class="flex justify-between items-center border-b pb-3">
                        <div>
                            <h3 id="active-bus-route-title" class="font-bold text-slate-900 text-lg">Bus Route Info</h3>
                            <p id="active-bus-fare-info" class="text-xs text-indigo-600 font-semibold mt-0.5">Fare: Rs. 0</p>
                        </div>
                        <div class="flex items-center gap-3 text-xs">
                            <span class="flex items-center gap-1"><span class="w-3 h-3 bg-emerald-500 rounded-sm inline-block"></span> Available</span>
                            <span class="flex items-center gap-1"><span class="w-3 h-3 bg-red-500 rounded-sm inline-block"></span> Booked</span>
                            <span class="flex items-center gap-1"><span class="w-3 h-3 bg-amber-500 rounded-sm inline-block"></span> Waiting</span>
                        </div>
                    </div>
                    <p class="text-xs text-slate-500">Select seats to book, or click a booked/waiting seat to <strong>Refund</strong> or <strong>Cancel</strong>.</p>
                    <div class="bg-slate-50 p-4 rounded-xl border max-h-64 overflow-y-auto">
                        <div id="terminal-seat-grid" class="grid grid-cols-4 sm:grid-cols-7 gap-2"></div>
                    </div>
                    <div class="flex justify-between items-center pt-2">
                        <span id="terminal-selected-seats-label" class="text-xs font-bold text-indigo-700">Selected Seats: None</span>
                        <button onclick="openBookingDetailsModal()" id="proceed-booking-btn" disabled class="bg-indigo-600 disabled:bg-slate-300 text-white px-5 py-2 rounded-xl text-sm font-medium transition shadow">Proceed to Passenger Details</button>
                    </div>
                </div>
            </div>

            <!-- Terminal Tab 2: Close Voucher -->
            <div id="term-tab-voucher" class="hidden space-y-6">
                <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 max-w-2xl mx-auto">
                    <h3 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2"><span>📑</span> Close Trip Voucher</h3>
                    <form onsubmit="handleCalculateVoucher(event)" class="space-y-4 mb-6">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-medium text-slate-600 mb-1">Bus Number / Name</label>
                                <input type="text" id="voucher-bus-name" required placeholder="e.g. Kahloon Express" class="w-full px-3 py-2 text-sm border rounded-lg outline-none">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-600 mb-1">Route (From - To)</label>
                                <input type="text" id="voucher-route" required placeholder="e.g. Lahore to Multan" class="w-full px-3 py-2 text-sm border rounded-lg outline-none">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-600 mb-1">Trip Date</label>
                                <input type="date" id="voucher-date" required class="w-full px-3 py-2 text-sm border rounded-lg outline-none">
                            </div>
                        </div>
                        <button type="submit" class="w-full bg-indigo-600 text-white py-2.5 rounded-xl text-sm font-medium hover:bg-indigo-700 transition">Fetch Trip Summary & Open Voucher</button>
                    </form>

                    <!-- Printable Voucher Card Preview with Live Commission Input -->
                    <div id="printable-voucher-area" class="hidden bg-slate-50 border border-slate-200 rounded-2xl p-6 space-y-4">
                        <div class="text-center border-b pb-4">
                            <h4 id="v-terminal-name" class="font-bold text-slate-900 text-lg">Terminal Name</h4>
                            <p id="v-terminal-address" class="text-xs text-slate-500">Address & Contact</p>
                            <span class="inline-block mt-2 text-[10px] bg-indigo-100 text-indigo-800 px-2 py-0.5 rounded-full font-bold">OFFICIAL TRIP VOUCHER</span>
                        </div>
                        <div class="grid grid-cols-2 gap-2 text-xs text-slate-700">
                            <p><strong>Bus Name:</strong> <span id="v-bus">--</span></p>
                            <p><strong>Route:</strong> <span id="v-route">--</span></p>
                            <p><strong>Date:</strong> <span id="v-date">--</span></p>
                            <p><strong>Total Tickets Booked:</strong> <span id="v-total-passengers" class="font-bold text-indigo-700 text-sm">0</span></p>
                        </div>

                        <!-- Commission Input Field right inside the Voucher preview -->
                        <div class="bg-indigo-50/60 p-4 rounded-xl border border-indigo-100 space-y-3">
                            <label class="block text-xs font-bold text-indigo-900">Enter Commission / Deduction Amount (Rs.)</label>
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-bold text-indigo-700">Rs.</span>
                                <input type="number" id="voucher-live-commission" oninput="updateVoucherCalculations()" value="0" min="0" class="w-full px-3 py-2 text-sm border rounded-lg outline-none bg-white font-bold text-indigo-900">
                            </div>
                            <p class="text-[10px] text-slate-500">Commission is automatically subtracted from the total gross fare below.</p>
                        </div>

                        <div class="border-t pt-3 space-y-1.5 text-xs text-slate-800">
                            <div class="flex justify-between"><span>Gross Total Fare (Terminal Bookings):</span> <strong id="v-gross-fare">Rs. 0</strong></div>
                            <div class="flex justify-between text-red-600"><span>Deducted Commission:</span> <strong id="v-deducted-comm">Rs. 0</strong></div>
                            <div class="flex justify-between text-sm font-bold text-indigo-700 border-t pt-2 bg-indigo-50 p-2.5 rounded-lg"><span>Net Payable Amount:</span> <strong id="v-net-fare">Rs. 0</strong></div>
                        </div>
                        <div class="flex gap-3 pt-4">
                            <button onclick="window.print()" class="w-1/2 bg-emerald-600 text-white py-2.5 rounded-xl text-xs font-bold hover:bg-emerald-700 transition flex items-center justify-center gap-1"><span>🖨️</span> Print Voucher</button>
                            <button onclick="saveAndFinalizeVoucher()" class="w-1/2 bg-indigo-600 text-white py-2.5 rounded-xl text-xs font-bold hover:bg-indigo-700 transition">Save & Close Voucher</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Terminal Tab 3: Previous Records & Refund/Cancel -->
            <div id="term-tab-records" class="hidden space-y-6">
                <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 space-y-4">
                    <h3 class="text-lg font-bold text-slate-900 mb-2 flex items-center gap-2"><span>📊</span> 30-Day Terminal Records & Refund/Cancel Manager</h3>
                    <p class="text-xs text-slate-500">You can view booking history, search tickets, and instantly <strong>Refund</strong> or <strong>Cancel</strong> any ticket with 1 click.</p>
                    
                    <div class="flex flex-wrap gap-3 border-b pb-4">
                        <button onclick="switchRecordSubTab('passengers')" id="rec-sub-btn-passengers" class="px-4 py-2 text-xs font-bold rounded-lg bg-indigo-600 text-white">Passenger Records (30 Days)</button>
                        <button onclick="switchRecordSubTab('vouchers')" id="rec-sub-btn-vouchers" class="px-4 py-2 text-xs font-bold rounded-lg bg-slate-200 text-slate-700">Voucher Records (30 Days)</button>
                    </div>

                    <!-- Filter Bar for Records -->
                    <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 bg-slate-50 p-4 rounded-xl border">
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">Bus Number / Name</label>
                            <input type="text" id="filter-bus" placeholder="e.g. Kahloon Express" class="w-full px-3 py-2 text-xs border rounded-lg outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">Date</label>
                            <input type="date" id="filter-date" class="w-full px-3 py-2 text-xs border rounded-lg outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">Time</label>
                            <input type=
